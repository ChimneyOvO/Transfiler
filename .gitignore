# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyInstaller / Build artifacts
build/
dist/
dist_installer/
*.manifest
*.spec.bak
*.zip
*.tar.gz

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/

# Temporary runtime storage & webview caches
data/webview_storage/
data/EBWebView/
data/*.log
*.log

# Runtime SQLite databases (protects local credentials and history)
data/*.db
data/*.db-journal
*.db
!data/.gitkeep

# User uploaded files & exported results (keep directory structure)
uploads/*
!uploads/.gitkeep
exported_docs/*
!exported_docs/.gitkeep

# Sensitive test credentials
测试API KEY.txt
*.key
*.pem

# Editor & IDE configs
.vscode/
.idea/
*.swp
*.swo

# AI Agent / Skills & external tool artifacts (local only)
.agents/
skills/
taste-skill-main/
_taste_skill_repo/

# Local design specs, prototypes & test samples
CODE_EXPLANATION.md
Transfiler_PRD.md
ui_prototype_preview.html
sample_docs/

# OS temporary files
Thumbs.db
Desktop.ini
~$*.xlsx
~$*.docx
~$*.doc

